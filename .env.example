# Copiar a .env. Nunca subir .env con claves reales.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

POSTGRES_USER=sportbet
POSTGRES_PASSWORD=sportbet
POSTGRES_DB=sportbet
DATABASE_URL=postgres://sportbet:sportbet@localhost:5432/sportbet?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:4200

JWT_SECRET=cambia-esto-minimo-32-caracteres-xx
JWT_ISSUER=sportbet
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
REFRESH_COOKIE_SECURE=false
ADMIN_SEED_EMAIL=admin@sportbet.local
# Solo desarrollo; vacío = no se crea el admin
ADMIN_SEED_PASSWORD=

# Pendiente de confirmar (100000 = 1 000.00 de saldo virtual)
WALLET_INITIAL_BALANCE_CENTS=100000

# replay | apifootball
PROVIDER=replay
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_KEY=
PROVIDER_DAILY_BUDGET=100
PROVIDER_RESERVE=13
# IDs de API-Football separados por coma, p. ej. 39,140
FEATURED_LEAGUE_IDS=
SYNC_FIXTURES_INTERVAL=12h
SYNC_LIVE_INTERVAL=3m
LIVE_STALE_AFTER=5m
REPLAY_FILE=./testdata/replay/sample_match.json
REPLAY_SPEED=60

SETTLEMENT_SWEEP_INTERVAL=2m
ODDS_MARGIN_PERCENT=6
